{
  "id": "quant-trading",
  "name": "Quant Trading",
  "description": "Quantitative trading toolkit: market data, strategy backtesting, portfolio management, trading signals, and live broker trading for stocks, futures, and funds.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dataDir": {
        "type": "string",
        "description": "Directory to store market data, backtest results, and strategy configs. Defaults to ~/.openclaw/quant-trading/"
      },
      "defaultMarket": {
        "type": "string",
        "enum": [
          "cn_stock",
          "us_stock",
          "hk_stock",
          "futures",
          "fund",
          "crypto",
          "etf_option",
          "index_option",
          "commodity_option"
        ],
        "description": "Default market to use when not specified"
      },
      "dataProviders": {
        "type": "object",
        "description": "External data provider configurations (akshare, tushare, etc.)",
        "properties": {
          "akshare": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "tushare": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "token": { "type": "string" }
            }
          },
          "yfinance": {
            "type": "object",
            "description": "Yahoo Finance data provider for US/global market data",
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "jqdata": {
            "type": "object",
            "description": "JQData (聚宽) data provider for A-share market data",
            "properties": {
              "enabled": { "type": "boolean" },
              "username": { "type": "string", "description": "JQData account username" },
              "password": { "type": "string", "description": "JQData account password" }
            }
          },
          "fred": {
            "type": "object",
            "description": "FRED (Federal Reserve Economic Data) API for US macro indicators",
            "properties": {
              "enabled": { "type": "boolean" },
              "apiKey": {
                "type": "string",
                "description": "FRED API key (free at https://fred.stlouisfed.org/docs/api/)"
              }
            }
          },
          "sentiment": {
            "type": "object",
            "description": "Social sentiment data source configuration",
            "properties": {
              "sources": {
                "type": "array",
                "items": { "type": "string", "enum": ["eastmoney", "baidu", "xueqiu"] },
                "description": "Enabled sentiment data sources (default: all)"
              },
              "syncIntervalMinutes": {
                "type": "number",
                "description": "Sentiment sync interval in minutes during market hours (default: 30)"
              }
            }
          },
          "institutional": {
            "type": "object",
            "description": "Institutional flow data sync configuration",
            "properties": {
              "syncFrequency": {
                "type": "string",
                "enum": ["daily", "weekly"],
                "description": "How often to refresh institutional holding data (default: weekly)"
              }
            }
          }
        }
      },
      "backtestEngine": {
        "type": "string",
        "enum": ["builtin", "backtrader", "vnpy"],
        "description": "Backtest engine to use. 'builtin' is a lightweight JS engine; 'backtrader' and 'vnpy' delegate to Python."
      },
      "pythonPath": {
        "type": "string",
        "description": "Path to Python executable for backtrader/xtquant integration"
      },
      "tradingAccount": {
        "type": "object",
        "description": "Live/paper trading account configuration",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["paper", "live"],
            "description": "Trading mode: paper (simulated) or live (real money)"
          },
          "broker": {
            "type": "string",
            "enum": ["paper", "qmt", "remote-qmt", "futu", "ib", "eastmoney"],
            "description": "Broker to use for live trading. 'paper' runs a local simulation."
          },
          "confirmationRequired": {
            "type": "boolean",
            "description": "If true, orders above confirmationThreshold require human /confirm before submission"
          },
          "confirmationChannel": {
            "type": "string",
            "description": "Channel ID to send confirmation requests to (defaults to current chat)"
          },
          "riskLimits": {
            "type": "object",
            "description": "Pre-trade risk rules",
            "properties": {
              "maxOrderValue": {
                "type": "number",
                "description": "Maximum single order notional value in CNY (default: 500000)"
              },
              "maxPositionPct": {
                "type": "number",
                "description": "Maximum single-position concentration as fraction of total assets (default: 0.30)"
              },
              "maxDailyLoss": {
                "type": "number",
                "description": "Maximum realised daily loss in CNY before engine auto-pauses (default: 50000)"
              },
              "maxTotalLoss": {
                "type": "number",
                "description": "Maximum total loss in CNY (default: 200000)"
              },
              "confirmationThreshold": {
                "type": "number",
                "description": "Order value above which human confirmation is required (default: 100000)"
              },
              "allowedSymbols": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Whitelist of tradable symbols; empty = all allowed"
              },
              "blockedSymbols": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Blacklist of forbidden symbols"
              },
              "maxNakedShort": {
                "type": "number",
                "description": "Maximum naked short option contracts (default: 0 = no naked short allowed)"
              },
              "maxDeltaExposure": {
                "type": "number",
                "description": "Maximum absolute portfolio Delta exposure (default: 500)"
              },
              "maxGammaExposure": {
                "type": "number",
                "description": "Maximum absolute portfolio Gamma exposure (default: 100)"
              },
              "maxVegaExposure": {
                "type": "number",
                "description": "Maximum absolute portfolio Vega exposure (default: 10000)"
              },
              "nearExpiryDays": {
                "type": "number",
                "description": "Block sell_open on options expiring within N days (default: 3)"
              }
            }
          },
          "autoStart": {
            "type": "boolean",
            "description": "If true, automatically start the trading engine when the plugin loads (default: false)"
          },
          "qmt": {
            "type": "object",
            "description": "QMT (迅投 miniQMT) broker configuration",
            "properties": {
              "miniQmtPath": {
                "type": "string",
                "description": "Path to the miniQMT installation directory"
              },
              "windowsBridgeUrl": {
                "type": "string",
                "description": "URL of the Windows bridge server for remote-qmt mode (e.g. http://192.168.3.30:58088)"
              },
              "accountId": {
                "type": "string",
                "description": "QMT account ID (券商账号)"
              },
              "accountType": {
                "type": "string",
                "enum": ["STOCK", "FUTURES", "CREDIT", "OPTIONS"],
                "description": "Account type (default: STOCK)"
              }
            }
          },
          "futu": {
            "type": "object",
            "description": "Futu OpenD broker configuration",
            "properties": {
              "host": { "type": "string", "description": "OpenD host (default: 127.0.0.1)" },
              "port": { "type": "number", "description": "OpenD port (default: 11111)" },
              "tradePwd": { "type": "string", "description": "Trading password (MD5-hashed)" },
              "accountId": { "type": "string", "description": "Futu account ID" }
            }
          }
        }
      },
      "notifications": {
        "type": "object",
        "properties": {
          "signalAlerts": {
            "type": "boolean",
            "description": "Send alerts when strategy generates buy/sell signals"
          },
          "dailyReport": {
            "type": "boolean",
            "description": "Send daily portfolio performance summary"
          },
          "riskAlerts": { "type": "boolean", "description": "Alert on risk threshold breaches" }
        }
      },
      "signalWebhook": {
        "type": "object",
        "description": "Signal webhook configuration for receiving trading signals from external systems (e.g. QMT)",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Shared secret for authenticating incoming webhook requests (X-Signal-Secret header)"
          }
        }
      },
      "optionsConfig": {
        "type": "object",
        "description": "期权交易模块配置 (Options trading module)",
        "properties": {
          "greeksSource": {
            "type": "string",
            "enum": ["market", "local", "auto"],
            "description": "Greeks calculation source: market=exchange-pushed, local=BSM/BAW, auto=prefer market with local fallback (default: auto)"
          },
          "riskFreeRate": {
            "type": "number",
            "description": "Annual risk-free rate for BSM pricing (default: 0.02)"
          },
          "defaultMultiplier": {
            "type": "number",
            "description": "Default contract multiplier (default: 10000 for ETF options)"
          },
          "dividendYield": {
            "type": "number",
            "description": "Dividend yield of underlying (default: 0)"
          },
          "monitor": {
            "type": "object",
            "description": "Options monitoring service configuration",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable options monitor (default: true)"
              },
              "greeksRefreshSecs": {
                "type": "number",
                "description": "Greeks refresh interval in seconds (default: 30)"
              },
              "expiryWarningDays": {
                "type": "array",
                "items": { "type": "number" },
                "description": "Days before expiry to send warnings (default: [3, 1, 0])"
              },
              "ivAlertThreshold": {
                "type": "number",
                "description": "IV deviation alert threshold in std devs (default: 2.0)"
              }
            }
          }
        }
      },
      "openclawProxyPort": {
        "type": "number",
        "description": "Port for the OpenClaw iframe reverse proxy. When set, a proxy is started that strips X-Frame-Options/CSP headers, allowing the admin panel to embed the OpenClaw chat UI via iframe. Example: 18890"
      },
      "receiver": {
        "type": "object",
        "description": "RECEIVER.py bridge service configuration",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether to auto-start RECEIVER.py (default: true)"
          },
          "port": {
            "type": "number",
            "description": "Listen port for RECEIVER.py (default: 58088)"
          },
          "host": {
            "type": "string",
            "description": "Listen host for RECEIVER.py (default: 0.0.0.0)"
          }
        }
      }
    }
  }
}
