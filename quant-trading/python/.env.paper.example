# ============================================================
# Aipha-Q — 模拟盘环境变量配置 (.env.paper)
# ============================================================
# 用法：cd docker && docker compose -f docker-compose.paper.yml up -d
# 安全：此文件包含敏感信息，已在 .gitignore 中排除
# 模板：参见 .env.paper.example
# ============================================================

# ---- 行情数据 API ----
TUSHARE_TOKEN=your_tushare_token_here

# ---- 平台环境标识 ----
AIPHA_ENV=paper
PLATFORM_PORT=8502

# ---- 认证 Cookie 密钥（必须与 research 环境不同！） ----
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
AIPHA_AUTH_SECRET=change_me_paper_32bytes_secret

# ---- 告警通知：飞书机器人 ----
# 飞书设置：群聊 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook URL
FEISHU_WEBHOOK=

# ---- 可选：其他告警通道 ----
# DINGTALK_WEBHOOK=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---- 可选：日志级别 ----
LOG_LEVEL=WARNING
