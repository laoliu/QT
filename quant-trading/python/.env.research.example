# ============================================================
# Aipha-Q — 研究环境变量配置 (.env.research)
# ============================================================
# 用法：cd docker && docker compose -f docker-compose.research.yml up -d
# 安全：此文件包含敏感信息，已在 .gitignore 中排除
# 模板：参见 .env.research.example
# ============================================================

# ---- 行情数据 API ----
TUSHARE_TOKEN=your_tushare_token_here

# ---- 平台环境标识 ----
AIPHA_ENV=research
PLATFORM_PORT=8501

# ---- 认证 Cookie 密钥（请修改为随机字符串，勿与 paper 环境共用） ----
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
AIPHA_AUTH_SECRET=change_me_research_32bytes_secret

# ---- 可选：日志级别 ----
LOG_LEVEL=INFO
