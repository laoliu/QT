# Aipha-Q 环境配置示例
# 复制此文件为 .env 并填入真实配置

# =============================================================================
# 数据源配置
# =============================================================================

# TuShare Pro API Token
# 获取方式：https://tushare.pro/ -> 个人中心 -> 接口TOKEN
TUSHARE_TOKEN=your_tushare_token_here

# TuShare 账号积分档位（仅用于注释说明，影响各 API 的日调用上限）
# 当前账号：5000积分（正式账号）
# ─────────────────────────────────────────────────────────────────
# 本系统使用的 TuShare 接口汇总及积分要求：
#
# 【可转债核心 — 当前已满足】
#   cb_basic      (CB基础信息)     : 2000积分
#   cb_daily      (CB日行情+溢价)  : 2000积分
#   cb_call       (强赎/到赎公告)  : 2000积分
#
# 【A股核心 — 当前已满足】
#   daily         (日线行情)       : 2000积分
#   adj_factor    (复权因子)       : 2000积分
#   stock_basic   (股票基础信息)   : 2000积分
#   daily_basic   (每日指标:市值/PE/换手率) : 2000积分
#   namechange    (股票更名历史)   : 2000积分
#   trade_cal     (交易日历)       : 免费
#
# 【财务 PIT — 当前已满足】
#   fina_indicator (财务指标:ROE等): 2000积分
#   income         (利润表)        : 2000积分
#   balancesheet   (资产负债表)    : 2000积分
#   cashflow       (现金流量表)    : 2000积分
#
# 【指数 — 当前已满足】
#   index_classify (指数分类)      : 2000积分
#   index_member   (指数成分股)    : 2000积分
#   index_weight   (指数权重)      : 2000积分
#
# 【替代数据 — 当前已满足】
#   cyq_perf      (筹码分布,2018+) : 5000积分 ✓
#   moneyflow     (个股资金流向)   : 2000积分
#   margin_detail (融资融券明细)   : 5000积分 ✓
#   report_rc     (分析师预测)     : 2000积分，速率2 QPS
#                                    TuShareGateway 内置限流统一处理
#
# 【升级到 10000积分可新增（当前策略研发规划中需要）】
#   forecast      (业绩预告)       : 10000积分，用于盈利加速因子
#   express       (业绩快报)       : 10000积分，用于盈利加速因子
#   stk_holdernumber (股东人数)    : 10000积分，用于散户密度因子
#   所有接口日调用上限解除         : 当前 5000积分下各接口仍有日总量限制
#
# 结论：当前 5000积分满足所有已实现功能。
#       升级 10000积分主要收益：①解锁 forecast/express/stk_holdernumber
#       ②所有接口无日总量限制（批量下载不需要任何sleep）。
# 查看/升级积分：https://tushare.pro/weborder/#/permission
TUSHARE_POINTS=5000

# =============================================================================
# 回测配置（可选）
# =============================================================================

# 默认初始资金
DEFAULT_INITIAL_CAPITAL=1000000

# 默认无风险利率（年化）
DEFAULT_RISK_FREE_RATE=0.02

# =============================================================================
# 缓存配置
# =============================================================================

# 数据缓存目录
DATA_CACHE_DIR=data/cache

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志输出目录
LOG_DIR=logs

# =============================================================================
# Docker 部署配置（可选）
# =============================================================================

# Streamlit 平台端口（默认 8501）
PLATFORM_PORT=8501

# 运行环境：backtest | paper | production
AIPHA_ENV=backtest

# =============================================================================
# 告警通知（可选）
# =============================================================================

# 飞书机器人 Webhook
FEISHU_WEBHOOK=

# 钉钉机器人 Webhook
DINGTALK_WEBHOOK=

# 邮件告警
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# =============================================================================
# A股交易费率配置（回测/模拟/实盘共用）
# =============================================================================

# 佣金费率（万分之 X，例如万0.854 = 0.0000854）
COMMISSION_RATE=0.0000854

# 最低佣金（元）
COMMISSION_MIN=5.0

# 印花税率（卖出方，2023-08-28 后为千0.5）
# 注意：2023-08-28 之前为千1，脚本内部自动按日期切换
STAMP_TAX_SELL=0.0005

# 过户费（万0.1 = 0.00001）
TRANSFER_FEE=0.00001

# 滑点固定价差（bps）
SLIPPAGE_SPREAD_BPS=3.0

# 市场冲击系数
IMPACT_COEFF=10.0

# 单票最大参与率（占当日成交额比例）
MAX_PARTICIPATION=0.10

# A股最小交易单位（股）
LOT_SIZE=100

# =============================================================================
# 可转债交易费率配置（回测/模拟/实盘共用）
# =============================================================================

# CB 佣金费率（万0.854 = 0.0000854）
CB_COMMISSION_RATE=0.0000854

# CB 最低佣金（元，与A股一致为5元起）
CB_COMMISSION_MIN=5.0

# CB 印花税（无印花税）
CB_STAMP_TAX_SELL=0.0

# CB 过户费（无过户费）
CB_TRANSFER_FEE=0.0

# CB 滑点固定价差（bps, §13.1 MarketRulesConvertibleBond）
CB_SLIPPAGE_BPS=5.0

# CB 最小交易单位（张）
CB_LOT_SIZE=10

# =============================================================================
# QMT / miniQMT 配置
# =============================================================================

# QMT 安装路径（用于自动搜索 xtquant 库）
# 例如：D:\st_lc
QMT_PATH=

# QMT 安装目录（start_qmt_bridge.bat 使用，通常与 QMT_PATH 相同）
# 例如：D:\st_lc
QMT_INSTALL_DIR=

# miniQMT userdata 路径（用于 XtQuantTrader 交易连接）
# 例如：D:\st_lc\userdata_mini
MINI_QMT_PATH=

# 数据桥接 HTTP 服务监听地址和端口
SERVE_HOST=0.0.0.0
SERVE_PORT=18888

# 券商交易账号
TRADING_ACCOUNT_ID=

# 账户类型：STOCK / FUTURES / CREDIT / OPTIONS（默认 STOCK）
TRADING_ACCOUNT_TYPE=STOCK

# =============================================================================
# Quant Trading 应用配置
# =============================================================================

# Windows QMT 数据桥接 URL（Mac/Linux 远程连接 Windows 桥时使用）
# 例如：http://192.168.3.30:18888
WINDOWS_XTDATA_URL=

# 本地 Parquet 数据目录（离线数据源）
# 例如：G:/qtdata
QTDATA_DIR=

# FRED 宏观数据 API Key（美联储经济数据）
# 获取：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# JQData（聚宽）账号（可选数据源）
JQDATA_USERNAME=
JQDATA_PASSWORD=

# WxPusher 微信推送 App Token（交易信号推送）
# 获取：https://wxpusher.zjiecode.com/admin/main/app/appToken
WXPUSHER_APP_TOKEN=

# Python 解释器路径（龙虾调用 Python 子进程时使用，默认自动检测）
# 例如：C:\Python311\python.exe
PYTHON_BIN=
